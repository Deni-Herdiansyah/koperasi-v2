
#--------------------------------------------------------------------
# ENVIRONMENT
# Ubah ke 'production' saat deploy ke hosting
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP URL
# Sesuaikan dengan URL instalasi Anda (TAMBAHKAN PORT JIKA BUKAN PORT 80)
# Contoh lokal default : http://localhost/koperasi-app-master/public/
# Contoh lokal custom  : http://localhost:8088/koperasi-app-master/public/
# Contoh hosting       : https://namadomain.com/
#--------------------------------------------------------------------
# app.baseURL = 'http://localhost:8080/koperasi-app-master/public/'
app.baseURL = 'http://localhost/koperasi-app-master/public/'
# app.baseURL = 'https://kpri.gentrajuara.my.id/'

#--------------------------------------------------------------------
# DATABASE
# Isi sesuai konfigurasi MySQL Anda
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = db_koperasi
database.default.username = root
database.default.password = ''
# database.default.DBDriver = MySQLi
database.default.port     = 3306

encryption.key = hex2bin:35e8f5212ac3e168bce140be9568eccbb598d5679464bd83bb0de271073585ee